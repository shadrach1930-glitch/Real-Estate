# Application
APP_ENV=development
APP_NAME=PrimeHomes Lead Bot
DEBUG=true

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/primehomes

# AI Configuration (do not hard-code real keys)
AI_PROVIDER=google
AI_MODEL=
AI_API_KEY=
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=1000

# n8n
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook/primehomes/chat
N8N_WEBHOOK_SECRET=change-me-to-a-long-random-string

# Frontend
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Authentication (for internal / sales endpoints)
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Notifications (optional for MVP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_FROM_EMAIL=

# Google Sheets (optional)
GOOGLE_SHEETS_CREDENTIALS=
GOOGLE_SHEETS_ID=

# Logging
LOG_LEVEL=INFO

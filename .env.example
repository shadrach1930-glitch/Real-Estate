# Application
APP_ENV=development
APP_NAME=PrimeHomes Lead Bot
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/primehomes

# AI
AI_PROVIDER=openai
AI_MODEL=
AI_API_KEY=
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=1000

# n8n
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook/primehomes/chat
N8N_WEBHOOK_SECRET=change-me-to-a-long-random-string

# Frontend
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Auth
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Sales portal login (MVP single user)
SALES_USER_EMAIL=sales@primehomes.ng
SALES_USER_PASSWORD=changeme123
SALES_USER_NAME=Sales Manager

# Google Sheets (optional — leave blank to disable)
GOOGLE_SHEETS_CREDENTIALS=/path/to/service-account.json
GOOGLE_SHEETS_ID=

# Logging
LOG_LEVEL=INFO
